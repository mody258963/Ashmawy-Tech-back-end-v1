APP_NAME="Ashmawy Tech"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3307
DB_DATABASE=user
DB_USERNAME=user
DB_PASSWORD=user123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- IoT SaaS (Passport guard iot-api, web /iot dashboard, EMQX) ---
# HS256 secret for device MQTT JWT (min 32 chars). Must match EMQX JWT authenticator secret in production.
IOT_JWT_SECRET=change-this-secret-min-32-chars-long!!
IOT_JWT_TTL_SECONDS=2592000
IOT_JWT_ISS="${APP_URL}"
IOT_QUEUE=iot

# Latest telemetry & module snapshots (MQTT QoS 0 path) — Flutter reads via API + Redis.
IOT_REDIS_KEY_PREFIX=iot:v1
IOT_SENSOR_REDIS_TTL=2592000
IOT_PERSIST_SENSOR_READINGS_TO_DB=false
# Process sensor MQTT in iot:mqtt-subscribe (true = no queue worker required for /latest).
IOT_SENSOR_PROCESS_INLINE=true
# Optional dual-write for historical charts (requires worker + subscriber running 24/7 regardless of app opens).

# MQTT subscriber connects only while Flutter sends POST .../ingestion/heartbeat (Redis lease).
# Keep `iot:mqtt-subscribe` supervised forever; it sleeps cheaply until lease appears.
IOT_SUBSCRIBER_DEMAND_GATED=false

# Laravel → EMQX (use host "emqx" inside Docker Compose network; 127.0.0.1 on local machine)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Used only by `php artisan iot:mqtt-subscribe` (long-lived). EMQX: one session per client_id.
MQTT_CLIENT_ID=laravel-iot-backend
# HTTP/queue publishes use the `publisher` MQTT connection; base id + host/pid suffix (never steals the subscriber session).
MQTT_PUBLISHER_CLIENT_ID=laravel-iot-backend-publisher
# Bridge user for php artisan iot:mqtt-subscribe / publish (not device JWT). If EMQX has allow_anonymous=false,
# create this user in EMQX (e.g. Dashboard → Authentication → Built-in database) with the same password.
MQTT_AUTH_USERNAME=laravel_bridge
MQTT_AUTH_PASSWORD=k8Rm3qW9vL2nX7pJ4sH6tY1z
MQTT_ENABLE_LOGGING=false
MQTT_CLEAN_SESSION=false
# Prefer false: php-mqtt auto-reconnect can reuse a stale client_id with EMQX (EOF storm). Subscriber reconnects via artisan loop.
MQTT_AUTO_RECONNECT_ENABLED=false

# IoT: POST .../components/{id}/action waits for ESP status echo (Redis); device must publish message_id from command.
IOT_ACTION_ACK_WAIT_MS=8000

# IoT ingestion (runs on the SERVER continuously — not when the Flutter app opens):
# `php artisan iot:mqtt-subscribe` + `php artisan queue:work --queue=iot` (uses QUEUE_CONNECTION).
# Official Docker image: both run via supervisord (docker/supervisord.conf). Only set START_IOT_INGESTION=true
# in .env when your container CMD is NOT supervisord (e.g. custom entry CMD) — see docker/entrypoint.sh.
# REDIS_CLIENT / REDIS_* must be valid when using Redis snapshots above (same Redis server as CACHE optional).
